        <file alias="termdock-16.png">assets/icons/termdock-16.png</file>
        <file alias="termdock-32.png">assets/icons/termdock-32.png</file>
        <file alias="termdock-64.png">assets/icons/termdock-64.png</file>
        <file alias="termdock-256.png">assets/icons/termdock-256.png</file>
        <file alias="check.png">assets/icons/check.png</file>
        <file alias="chevron.png">assets/icons/chevron.png</file>
        <file alias="tab-close.png">assets/icons/tab-close-16.png</file>
        <file alias="tab-close-hover.png">assets/icons/tab-close-hover-16.png</file>
    </qresource>
</RCC>
